{
  "name": "dsh-auth-ldap",
  "version": "0.3.0",
  "description": "Authentication gate for DeepSeek Harness web profiles: local accounts and LDAP/Active Directory bind behind one login page.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "authentication",
    "authorization",
    "ldap",
    "active-directory",
    "login",
    "access-control",
    "self-hosted"
  ],
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farfoodyou/dsh-auth-ldap.git"
  },
  "homepage": "https://github.com/farfoodyou/dsh-auth-ldap#readme",
  "bugs": {
    "url": "https://github.com/farfoodyou/dsh-auth-ldap/issues"
  },
  "author": "dsh-auth-ldap contributors",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commitlint": "commitlint --edit",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run build",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "ldapts": "^9.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "bin": {
    "dsh-auth-ldap": "lib/cli.js"
  }
}
